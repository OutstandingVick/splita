# Firebase Web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional in development: App Check uses the debug token only.
# Required for production (reCAPTCHA Enterprise score-based site key).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Cloud models (both ONLY_IN_CLOUD). Leave empty for the defaults in packages/web/src/firebase-reasoner.ts.
# The fallback is tried after the primary's retries on 429/500/503 run out; "none" disables it.
NEXT_PUBLIC_CLOUD_MODEL=
NEXT_PUBLIC_FALLBACK_CLOUD_MODEL=
